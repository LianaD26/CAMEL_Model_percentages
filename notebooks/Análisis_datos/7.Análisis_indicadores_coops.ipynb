    "import re\n",
    "import unicodedata\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Configuracion\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "OUTPUT_DIR = Path(\"C:\\\\Users\\\\Liana\\\\Documents\\\\Repos\\\\CAMEL_Model_percentages\\\\output_indicators_images\")\n",
    "OUTPUT_DIR.mkdir(exist_ok=True)\n",
    "\n",
    "PERCENTILES = [0.10, 0.25, 0.50, 0.75, 0.90]\n",
    "\n",
    "\n",
    "def slugify(texto: str) -> str:\n",
    "    \"\"\"Convierte un nombre de indicador en un nombre de archivo seguro.\"\"\"\n",
    "    texto = unicodedata.normalize(\"NFKD\", texto).encode(\"ascii\", \"ignore\").decode()\n",
    "    texto = re.sub(r\"[^\\w\\s-]\", \"\", texto).strip().lower()\n",
    "    texto = re.sub(r\"[\\s/]+\", \"_\", texto)\n",
    "    return texto[:80]  # evita nombres de archivo demasiado largos\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Preparacion de datos (a partir de un DataFrame ya existente en el notebook)\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def preparar_datos(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"Valida columnas requeridas y agrega la columna 'fecha'.\n",
    "\n",
    "    No lee ningun archivo: se asume que 'df' ya esta cargado en el\n",
    "    notebook (por ejemplo, la variable 'indicators').\n",
    "    \"\"\"\n",
    "    columnas_requeridas = {\"ano\", \"mes\", \"ID_indicador\", \"ID_cooperativa\", \"valor\"}\n",
    "    faltantes = columnas_requeridas - set(df.columns)\n",
    "    if faltantes:\n",
    "        raise ValueError(f\"Faltan columnas requeridas en el DataFrame: {faltantes}\")\n",
    "\n",
    "    df = df.copy()\n",
    "    df[\"fecha\"] = pd.to_datetime(dict(year=df[\"ano\"], month=df[\"mes\"], day=1))\n",
    "    return df\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# 1. Banda de percentiles por mes (agregando todas las cooperativas)\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def graficar_banda_percentiles(df_ind: pd.DataFrame, nombre_indicador: str):\n",
    "    resumen = (\n",
    "        df_ind.groupby(\"fecha\")[\"valor\"]\n",
    "        .quantile(PERCENTILES)\n",
    "        .unstack()\n",
    "    )\n",
    "    resumen.columns = [f\"p{int(p*100)}\" for p in PERCENTILES]\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(9, 4.5))\n",
    "    ax.fill_between(resumen.index, resumen[\"p25\"], resumen[\"p75\"],\n",
    "                     alpha=0.25, label=\"Interquartile range (p25-p75)\")\n",
    "    ax.fill_between(resumen.index, resumen[\"p10\"], resumen[\"p90\"],\n",
    "                     alpha=0.10, label=\"Range p10-p90\")\n",
    "    ax.plot(resumen.index, resumen[\"p50\"], linewidth=2, label=\"Median\")\n",
    "\n",
    "    ax.set_title(f\"Monthly distribution of the indicator \\n'{nombre_indicador}'\")\n",
    "    ax.set_xlabel(\"Date\")\n",
    "    ax.set_ylabel(\"Value of the indicator\")\n",
    "    ax.legend(loc=\"best\", fontsize=8)\n",
    "    fig.tight_layout()\n",
    "\n",
    "    salida = OUTPUT_DIR / f\"tendencia_{slugify(nombre_indicador)}.png\"\n",
    "    fig.savefig(salida, dpi=150)\n",
    "    plt.show()\n",
    "    plt.close(fig)\n",
    "    return salida\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# 1b. Version facetada por categoria (tamano de cooperativa), si existe\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def graficar_banda_percentiles_por_categoria(df_ind: pd.DataFrame, nombre_indicador: str):\n",
    "    if \"categoria\" not in df_ind.columns:\n",
    "        return None\n",
    "\n",
    "    categorias = sorted(df_ind[\"categoria\"].dropna().unique())\n",
    "    if len(categorias) < 2:\n",
    "        return None\n",
    "\n",
    "    fig, axes = plt.subplots(1, len(categorias), figsize=(4.5 * len(categorias), 4),\n",
    "                              sharey=True)\n",
    "    if len(categorias) == 1:\n",
    "        axes = [axes]\n",
    "\n",
    "    for ax, cat in zip(axes, categorias):\n",
    "        sub = df_ind[df_ind[\"categoria\"] == cat]\n",
    "        resumen = sub.groupby(\"fecha\")[\"valor\"].quantile(PERCENTILES).unstack()\n",
    "        resumen.columns = [f\"p{int(p*100)}\" for p in PERCENTILES]\n",
    "\n",
    "        ax.fill_between(resumen.index, resumen[\"p25\"], resumen[\"p75\"], alpha=0.25)\n",
    "        ax.plot(resumen.index, resumen[\"p50\"], linewidth=2)\n",
    "        ax.set_title(str(cat), fontsize=10)\n",
    "        ax.tick_params(axis=\"x\", rotation=45)\n",
    "\n",
    "    fig.suptitle(f\"{nombre_indicador} - by cooperative size category\")\n",
    "    fig.tight_layout()\n",
    "\n",
    "    salida = OUTPUT_DIR / f\"tendencia_por_categoria_{slugify(nombre_indicador)}.png\"\n",
    "    fig.savefig(salida, dpi=150)\n",
    "    plt.show()\n",
    "    plt.close(fig)\n",
    "    return salida\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Histograma pooled (todas las observaciones cooperativa-mes juntas)\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def graficar_histograma(df_ind: pd.DataFrame, nombre_indicador: str):\n",
    "    fig, ax = plt.subplots(figsize=(7, 4.5))\n",
    "    ax.hist(df_ind[\"valor\"].dropna(), bins=40, edgecolor=\"white\")\n",
    "    ax.set_title(f\"Global distribution of the indicator \\n'{nombre_indicador}'\")\n",
    "    ax.set_xlabel(\"Value of the indicator\")\n",
    "    ax.set_ylabel(\"Frequency (cooperative-month)\")\n",
    "    fig.tight_layout()\n",
    "\n",
    "    salida = OUTPUT_DIR / f\"histograma_{slugify(nombre_indicador)}.png\"\n",
    "    fig.savefig(salida, dpi=150)\n",
    "    plt.show()\n",
    "    plt.close(fig)\n",
    "    return salida\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Tabla resumen de estadisticos (indicador x anio)\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def construir_tabla_resumen(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    resumen = (\n",
    "        df.groupby([\"ID_indicador\", \"ano\"])[\"valor\"]\n",
    "        .agg(\n",
    "            n=\"count\",\n",
    "            media=\"mean\",\n",
    "            mediana=\"median\",\n",
    "            desv_std=\"std\",\n",
    "            minimo=\"min\",\n",
    "            p10=lambda s: s.quantile(0.10),\n",
    "            p90=lambda s: s.quantile(0.90),\n",
    "            maximo=\"max\",\n",
    "        )\n",
    "        .reset_index()\n",
    "        .round(3)\n",
    "    )\n",
    "    return resumen\n",
    "\n",
    "\n",
    "def main(df_crudo: pd.DataFrame):\n",
    "    df = preparar_datos(df_crudo)\n",
    "\n",
    "    indicadores = df[\"ID_indicador\"].unique()\n",
    "    print(f\"Se encontraron {len(indicadores)} indicadores distintos.\")\n",
    "\n",
    "    for nombre_indicador in indicadores:\n",
    "        df_ind = df[df[\"ID_indicador\"] == nombre_indicador]\n",
    "        print(f\"Procesando: {nombre_indicador} ({len(df_ind)} registros)\")\n",
    "\n",
    "        graficar_banda_percentiles(df_ind, nombre_indicador)\n",
    "        graficar_banda_percentiles_por_categoria(df_ind, nombre_indicador)\n",
    "        graficar_histograma(df_ind, nombre_indicador)\n",
    "\n",
    "    tabla_resumen = construir_tabla_resumen(df)\n",
    "    ruta_resumen = OUTPUT_DIR / \"resumen_estadisticos.csv\"\n",
    "    tabla_resumen.to_csv(ruta_resumen, index=False)\n",
    "\n",
    "    print(f\"\\nListo. Graficas y tabla resumen guardadas en: {OUTPUT_DIR.resolve()}\")\n",
    "\n",
    "\n",
    "main(indicators)"
   ]
  },
